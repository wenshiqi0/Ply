#!/bin/sh
# Lint-fix staged TS/JS (the paths `npm run lint` covers), re-stage the fixes,
# and block the commit on what eslint cannot fix. Bypass with --no-verify.
# Enable once per clone: git config core.hooksPath .githooks
set -euf
cd "$(git rev-parse --show-toplevel)"
eslint=node_modules/.bin/eslint
if [ ! -x "$eslint" ]; then
  echo "pre-commit: eslint is missing; run npm ci --ignore-scripts" >&2
  exit 1
fi
IFS='
'
fix=
partial=
for file in $(git diff --cached --name-only --diff-filter=ACMR -- plugins packages/sdk examples/plugins type-tests); do
  case "$file" in *.ts|*.mts|*.js|*.mjs) ;; *) continue ;; esac
  if git diff --quiet -- "$file"; then fix="$fix$file$IFS"; else partial="$partial$file$IFS"; fi
done
status=0
if [ -n "$fix" ]; then
  "$eslint" --fix --max-warnings 0 $fix || status=1
  git add -- $fix
fi
# Re-staging a file with unstaged edits would commit them too, so only the
# staged copy is checked, without fixing.
for file in $partial; do
  git show ":$file" | "$eslint" --max-warnings 0 --stdin --stdin-filename "$file" || status=1
done
exit $status
