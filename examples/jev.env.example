# Copy outside the mounted workspace (e.g. ~/.config/wendy/jev.env), then fill.
# Host-only credential for automatic checks; absent -> user/environment approval.
# Never put the real key in this checked-in template.
TYPESAFE_API_KEY=

# Official native TypeSafe API. This is a base URL including /v1.
JEV_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-latest
JEV_TIMEOUT_MS=10000

# Client policy, not vendor-recommended universal safety thresholds.
# All risks <= allow -> execute; other outcomes require approval.
# deny is a high-risk recommendation, not the user's final decision.
JEV_ALLOW_MAX_RISK=0.10
JEV_DENY_MIN_RISK=0.90
JEV_MAX_STATE_BYTES=16384

# Environment-neutral coordination deadline; actual UI/service needs an adapter.
WENDY_APPROVAL_TIMEOUT_MS=300000
